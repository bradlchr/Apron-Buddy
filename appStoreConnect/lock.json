    "appInfoLocalization:en-US": {
      "fields": {
        "name": "Apron Buddy",
        "privacyPolicyUrl": "https://bradlchr.github.io/Apron-Buddy/#privacy",
        "subtitle": "Scan Recipes & Plan Meals"
      },
      "id": "830be9d5-6a39-478b-8dd9-ec166055935d",
      "type": "appInfoLocalizations"
    },
    "appStoreReviewDetail:IOS:1.0": {
      "fields": {
        "contactEmail": "ctbbradley@gmail.com",
        "contactFirstName": "Chris",
        "contactLastName": "Bradley",
        "contactPhone": "+1 913 424 2205",
        "demoAccountRequired": false,
        "notes": "No Apron Buddy account is required to use the recipe library. Recipes can remain on the device when iCloud is unavailable. iCloud sync and cookbook sharing require iCloud to be enabled.\n\nAdditional information requested from app review:\n1. Screen recording from my iPhone is attached\n2. The app's purpose is to store the user's recipes, import them via PDF or directly from webpage URLs. Organize recipes into cookbooks. Sync with iCloud and share cookbooks with your friends and family. It solves the problem of having a drawer full of recipe clippings from magazines or bookmarks in a browser. The recipes can be scanned, imported, organized, shared with others. The app then gives step-by-step directions in cooking mode. It also uses Apple Intelligence to generate meal plans using the user's stored recipes. These meal plans include a grocery list that can be exported to Reminders.\n3. No account needed. Signed in iCloud account required for syncing with other devices and sharing.\n4. None\n5. None\n6. N/A"
      },
      "id": "19d041cf-bf79-43f4-b835-aba8704aca71",
      "type": "appStoreReviewDetails"
    },
    "appStoreReviewDetail:MAC_OS:1.0": {
      "fields": {
        "contactEmail": "ctbbradley@gmail.com",
        "contactFirstName": "Chris",
        "contactLastName": "Bradley",
        "contactPhone": "+1 913 424 2205",
        "demoAccountRequired": false,
        "notes": "No Apron Buddy account is required to use the recipe library. Recipes can remain on the device when iCloud is unavailable. iCloud sync and cookbook sharing require iCloud to be enabled.\n\nUpdated from rejected App Review with requested information.\n 1. Screen recording from my iMac is attached\n2. The app's purpose is to store the user's recipes, import them via PDF or directly from webpage URLs. Organize recipes into cookbooks. Sync with iCloud and share cookbooks with your friends and family. It solves the problem of having a drawer full of recipe clippings from magazines or bookmarks in a browser. The recipes can be scanned, imported, organized, shared with others. The app then gives step-by-step directions in cooking mode. It also uses Apple Intelligence to generate meal plans using the user's stored recipes. These meal plans include a grocery list that can be exported to Reminders.\n3. No account needed. Signed in iCloud account required for syncing with other devices and sharing.\n4. None\n5. None\n6. N/A"
      },
      "id": "44eb7a80-fbaf-489f-a4f9-3df757d2db08",
      "type": "appStoreReviewDetails"
    },
