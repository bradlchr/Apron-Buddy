DEFINE SCHEMA

    RECORD TYPE CD_Cookbook (
        CD_canEditSharedCopy INT64 QUERYABLE SORTABLE,
        CD_cloudOwnerName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cloudZoneName     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt         TIMESTAMP QUERYABLE SORTABLE,
        CD_detail            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isCloudShared     INT64 QUERYABLE SORTABLE,
        CD_isSharedCopy      INT64 QUERYABLE SORTABLE,
        CD_name              STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"      TIMESTAMP,
        "___createdBy"       REFERENCE,
        "___etag"            STRING,
        "___modTime"         TIMESTAMP,
        "___modifiedBy"      REFERENCE,
        "___recordID"        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MealPlan (
        CD_constraints        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_dailyCalorieTarget INT64 QUERYABLE SORTABLE,
        CD_entityName         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_groceryItemsJSON   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_occasion           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_peopleEating       INT64 QUERYABLE SORTABLE,
        CD_plansLeftovers     INT64 QUERYABLE SORTABLE,
        CD_reminderListID     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_reminderListName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_slotsJSON          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startDate          TIMESTAMP QUERYABLE SORTABLE,
        CD_title              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_usesCalendar       INT64 QUERYABLE SORTABLE,
        "___createTime"       TIMESTAMP,
        "___createdBy"        REFERENCE,
        "___etag"             STRING,
        "___modTime"          TIMESTAMP,
        "___modifiedBy"       REFERENCE,
        "___recordID"         REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Recipe (
        CD_caloriesPerServing    INT64 QUERYABLE SORTABLE,
        CD_canEditSharedRecipe   INT64 QUERYABLE SORTABLE,
        CD_category              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cookMinutes           INT64 QUERYABLE SORTABLE,
        CD_cookbookIDsJSON       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt             TIMESTAMP QUERYABLE SORTABLE,
        CD_difficulty            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_goodForJSON           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ingredientsJSON       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isCloudSharedRecipe   INT64 QUERYABLE SORTABLE,
        CD_isFavorite            INT64 QUERYABLE SORTABLE,
        CD_isSharedRecipeCopy    INT64 QUERYABLE SORTABLE,
        CD_lastCooked            TIMESTAMP QUERYABLE SORTABLE,
        CD_name                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_photoData_ckAsset     ASSET,
        CD_prepMinutes           INT64 QUERYABLE SORTABLE,
        CD_rating                INT64 QUERYABLE SORTABLE,
        CD_servings              INT64 QUERYABLE SORTABLE,
        CD_sharedRecipeOwnerName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sharedRecipeZoneName  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceName            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceURL             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_stepsJSON             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_summary               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_userNotes             STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE MiseCookbook (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        cookbookID      STRING QUERYABLE SEARCHABLE SORTABLE,
        detail          STRING QUERYABLE SEARCHABLE SORTABLE,
        name            STRING QUERYABLE SEARCHABLE SORTABLE,
        recipeIDs       LIST<STRING> QUERYABLE SEARCHABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE MiseRecipe (
        "___createTime"    TIMESTAMP,
        "___createdBy"     REFERENCE,
        "___etag"          STRING,
        "___modTime"       TIMESTAMP,
        "___modifiedBy"    REFERENCE,
        "___recordID"      REFERENCE,
        caloriesPerServing INT64 QUERYABLE SORTABLE,
        category           STRING QUERYABLE SEARCHABLE SORTABLE,
        cookMinutes        INT64 QUERYABLE SORTABLE,
        createdAt          TIMESTAMP QUERYABLE SORTABLE,
        difficulty         STRING QUERYABLE SEARCHABLE SORTABLE,
        goodForJSON        STRING QUERYABLE SEARCHABLE SORTABLE,
        ingredientsJSON    STRING QUERYABLE SEARCHABLE SORTABLE,
        isFavorite         INT64 QUERYABLE SORTABLE,
        name               STRING QUERYABLE SEARCHABLE SORTABLE,
        photo              ASSET,
        prepMinutes        INT64 QUERYABLE SORTABLE,
        rating             INT64 QUERYABLE SORTABLE,
        servings           INT64 QUERYABLE SORTABLE,
        sourceName         STRING QUERYABLE SEARCHABLE SORTABLE,
        sourceURL          STRING QUERYABLE SEARCHABLE SORTABLE,
        stepsJSON          STRING QUERYABLE SEARCHABLE SORTABLE,
        summary            STRING QUERYABLE SEARCHABLE SORTABLE,
        userNotes          STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE MiseSharedRecipe (
        "___createTime"    TIMESTAMP,
        "___createdBy"     REFERENCE,
        "___etag"          STRING,
        "___modTime"       TIMESTAMP,
        "___modifiedBy"    REFERENCE,
        "___recordID"      REFERENCE,
        caloriesPerServing INT64 QUERYABLE SORTABLE,
        category           STRING QUERYABLE SEARCHABLE SORTABLE,
        cookMinutes        INT64 QUERYABLE SORTABLE,
        createdAt          TIMESTAMP QUERYABLE SORTABLE,
        difficulty         STRING QUERYABLE SEARCHABLE SORTABLE,
        goodForJSON        STRING QUERYABLE SEARCHABLE SORTABLE,
        ingredientsJSON    STRING QUERYABLE SEARCHABLE SORTABLE,
        isFavorite         INT64 QUERYABLE SORTABLE,
        name               STRING QUERYABLE SEARCHABLE SORTABLE,
        prepMinutes        INT64 QUERYABLE SORTABLE,
        rating             INT64 QUERYABLE SORTABLE,
        recipeID           STRING QUERYABLE SEARCHABLE SORTABLE,
        servings           INT64 QUERYABLE SORTABLE,
        sourceName         STRING QUERYABLE SEARCHABLE SORTABLE,
        sourceURL          STRING QUERYABLE SEARCHABLE SORTABLE,
        stepsJSON          STRING QUERYABLE SEARCHABLE SORTABLE,
        summary            STRING QUERYABLE SEARCHABLE SORTABLE,
        userNotes          STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE "cloudkit.share" (
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE,
        "cloudkit.thumbnailImageData" BYTES,
        "cloudkit.title"              STRING,
        "cloudkit.type"               STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
