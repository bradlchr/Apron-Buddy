<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Apron Buddy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Apron Buddy links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>apronbuddy</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Apron Buddy uses the camera to scan recipe pages and photograph finished dishes.</string>
	<key>NSContactsUsageDescription</key>
	<string>Apron Buddy uses your selected contact’s name and email or phone number to invite them to a private recipe share when you ask Siri to share a recipe.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Apron Buddy checks your calendar for busy evenings and dinner plans when you ask it to create a meal plan.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Apron Buddy adds grocery items to the Reminders list you choose.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Apron Buddy adds grocery items to the Reminders list you choose.</string>
	<key>CKSharingSupported</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
