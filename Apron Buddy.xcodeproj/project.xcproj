{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "App",
      "target-membership": [
        "Apron Buddy",
      ],
      "membership-exceptions": [
        {
          "target": "Apron Buddy",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "Apron Buddy Widget Extension",
          "inclusions": [
            "SharedWidgetData.swift",
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "App",
      "children": [
        { "path": "Assets.xcassets", "target-membership": [ "Apron Buddy Watch/resources" ] },
      ],
    }, {
      "kind": "folder",
      "path": "Watch",
      "target-membership": [
        "Apron Buddy Watch",
      ],
      "membership-exceptions": [
        {
          "target": "Apron Buddy Watch",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Apron Buddy Watch.app", "id": "4D871A25329624C7D27B83B5", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "Apron Buddy/copy/Embed Watch Content", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Apron Buddy.app", "id": "6FCFE669AD08195F38AEBFAD", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Apron Buddy Share.appex", "id": "8326E9C730AE8ED300FFFFFF", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Apron Buddy/copy/Embed Share Extension", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Apron Buddy Widget Extension.appex", "id": "838B3EF630B0A00A00FFFFFF", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Apron Buddy/copy/Embed Widget Extension", "header-preservation": "remove-on-copy" } ] },
      ],
    },
    { "kind": "folder", "path": "ShareExtension", "target-membership": [ "Apron Buddy Share" ] },
    {
      "kind": "folder",
      "path": "WidgetExtension",
      "target-membership": [
        "Apron Buddy Widget Extension",
      ],
      "membership-exceptions": [
        {
          "target": "Apron Buddy Widget Extension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Shared", "target-membership": [ "Apron Buddy", "Apron Buddy Widget Extension" ] },
  ],
  "targets": [
    {
      "name": "Apron Buddy",
      "id": "DABFF7B1B589EBC2B3F90E6E",
      "product": "Products/Apron Buddy.app",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "dependencies": [
        { "target": "Apron Buddy Watch", "platforms": [ "ios" ] },
        { "target": "Apron Buddy Share", "platforms": [ "ios" ] },
        "Apron Buddy Widget Extension",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        }, {
          "kind": "copy",
          "name": "Embed Share Extension",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Widget Extension",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES[sdk=iphone*]": "IconTerracotta IconDenim IconLinen IconMidnight",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "App/Mise.entitlements",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "CODE_SIGN_IDENTITY[sdk=macosx*]": "Apple Development",
        "CURRENT_PROJECT_VERSION": "5",
        "DEVELOPMENT_TEAM": "2FQZ8TQN3J",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "NO",
        "ENABLE_RESOURCE_ACCESS_BLUETOOTH": "NO",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "YES",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "NO",
        "ENABLE_RESOURCE_ACCESS_CONTACTS": "YES",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "NO",
        "ENABLE_RESOURCE_ACCESS_PRINTING": "NO",
        "ENABLE_RESOURCE_ACCESS_USB": "NO",
        "ENABLE_USER_SELECTED_FILES": "readwrite",
        "INFOPLIST_FILE": "App/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Apron Buddy",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.christopherbradley.newproject",
        "PRODUCT_NAME": "Apron Buddy",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "Apron Buddy Watch",
      "id": "7C74FF5D5EBAF0F5EA17DB23",
      "product": "Products/Apron Buddy Watch.app",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "build-phases": [
        "compile-sources",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "5",
        "DEVELOPMENT_TEAM": "2FQZ8TQN3J",
        "INFOPLIST_FILE": "Watch/Info.plist",
        "MARKETING_VERSION": "1.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.christopherbradley.newproject.watchkitapp",
        "PRODUCT_NAME": "Apron Buddy Watch",
        "SDKROOT": "watchos",
        "SKIP_INSTALL": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "4",
        "WATCHOS_DEPLOYMENT_TARGET": "26.0",
      },
    }, {
      "name": "Apron Buddy Share",
      "id": "8326E9C630AE8ED300FFFFFF",
      "product": "Products/Apron Buddy Share.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CODE_SIGN_ENTITLEMENTS": "ShareExtension/MiseShare.entitlements",
        "CURRENT_PROJECT_VERSION": "5",
        "DEVELOPMENT_TEAM": "2FQZ8TQN3J",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "ShareExtension/Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "MARKETING_VERSION": "1.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.christopherbradley.newproject.share",
        "PRODUCT_NAME": "Apron Buddy Share",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "Apron Buddy Widget Extension",
      "id": "838B3EF530B0A00A00FFFFFF",
      "product": "Products/Apron Buddy Widget Extension.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CODE_SIGN_ENTITLEMENTS": "WidgetExtension/ApronBuddyWidgets.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "5",
        "DEVELOPMENT_TEAM": "2FQZ8TQN3J",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "NO",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "WidgetExtension/Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.christopherbradley.newproject.widget",
        "PRODUCT_NAME": "Apron Buddy Widget Extension",
        "SDKROOT": "auto",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "CODE_SIGN_STYLE": "Automatic",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "$(inherited)",
      "DEBUG=1",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_VERSION": "5.0",
  },
  "last-upgrade": "14.3",
}
